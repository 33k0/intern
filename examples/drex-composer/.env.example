# Nace API key for Drex (starts with nace_sk_). Leave empty to run on the local stand-in:
# the panel then shows a STAND-IN badge and no request leaves this machine.
NACE_API_KEY=

# Model used for calls. Per-call overrides: DREX_MODEL_<CALLTYPE>, or server/gateway/models.ts.
DREX_MODEL=drex-max-v1.1

# Account tier, used to pace requests when a key is set: free = 120 requests/min and 8 in flight; paid = 1200 and 16.
DREX_TIER=free

# Stand-in only: rehearse a rate limit (120 = free tier) and simulated latency per call in ms.
# STANDIN_RPM=120
# STANDIN_LATENCY_MS=30-110

PORT=8787

# Nace documents two hosts for the same API. If console.nace.ai answers with a security-check page (HTTP 403), use the other:
# DREX_API_URL=https://drex.nace.ai/v1/systemone

# Intern, Nace's agent harness, as the producer (see INTERN.md). The model that does its work, and that provider's key:
# INTERN_SYSTEM2=deepinfra/<model>
# DEEPINFRA_API_KEY=
# Only needed if the commission endpoint is reached from another machine:
# PUBLIC_URL=https://your-tunnel.example
# COMPOSER_TOKEN=a-long-random-string
